# Mongo connection string. On Railway, set this via the MongoDB service's
# reference variable: MONGO_URL="${{MongoDB.MONGO_URL}}"
MONGO_URL=mongodb://localhost:27017/marchex

# Port the HTTP server listens on. Railway sets this automatically; default
# is used for local dev.
PORT=3000

# Shared secret that must appear in the webhook path: POST /webhooks/marchex/:token
# Generate a long random value, e.g. `openssl rand -hex 32`.
WEBHOOK_TOKEN=replace-with-a-long-random-token

# Dashboard login (single account, no self-signup).
DASHBOARD_USER=replace-with-a-username
DASHBOARD_PASSWORD=replace-with-a-strong-password

# Secret used to sign dashboard session cookies. Must be at least 32 bytes.
# Generate with `openssl rand -hex 32`.
SESSION_SECRET=replace-with-a-long-random-secret

# Optional: comma-separated list of URLs to seed into forward_targets on
# first boot (idempotent - safe to leave set across redeploys).
FORWARD_URLS=
