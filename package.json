{
  "name": "marchex-receiver-endpoint",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "dev:web": "npm --prefix web run dev",
    "build": "tsc -p tsconfig.json && npm --prefix web install && npm --prefix web run build",
    "start": "node dist/server.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "replay": "tsx scripts/replay-fixtures.ts"
  },
  "dependencies": {
    "@fastify/cookie": "^9.3.1",
    "@fastify/secure-session": "^7.5.1",
    "@fastify/static": "^7.0.4",
    "exceljs": "^4.4.0",
    "fastify": "^4.28.1",
    "mongodb": "^6.9.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^20.16.5",
    "mongodb-memory-server": "^10.0.1",
    "tsx": "^4.19.1",
    "typescript": "^5.6.2",
    "vitest": "^2.1.1"
  }
}
